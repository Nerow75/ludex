{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ludex",
  "version": "0.2.0",
  "identifier": "com.ludex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ludex",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0B0B0B"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' ludex: http://ludex.localhost https://cdn.cloudflare.steamstatic.com https://shared.akamai.steamstatic.com https://store-images.s-microsoft.com https://images.steamusercontent.com https://clan.akamai.steamstatic.com https://clan.fastly.steamstatic.com https://images.gog-statics.com",
        "media-src": "'self' ludex: http://ludex.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' ludex: http://ludex.localhost https://cdn.cloudflare.steamstatic.com https://shared.akamai.steamstatic.com https://store-images.s-microsoft.com https://images.steamusercontent.com https://clan.akamai.steamstatic.com https://clan.fastly.steamstatic.com https://images.gog-statics.com",
        "media-src": "'self' ludex: http://ludex.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Ludex",
    "category": "Game",
    "shortDescription": "Tous tes jeux, un seul launcher",
    "longDescription": "Ludex détecte les jeux installés par tous tes launchers et les lance depuis une seule interface.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ludex"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGMzdGNkM5MzMxNzZCMUIKUldRYmF4Y3p5ZlkzbjdNUWlIcEtaMlFhdEtkUkRFeWVmQTRRQ2NneWlRM0VJVlJMZjNPdkpYajcK",
      "endpoints": ["https://github.com/Nerow75/ludex/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
